{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {"rawaa-frontend": {"projectType": "application", "root": "", "sourceRoot": "src", "prefix": "app", "architect": {
    "build": {"builder": "@angular/build:application", "options": {"browser": "src/main.ts", "index": "src/index.html", "tsConfig": "tsconfig.app.json", "styles": ["node_modules/leaflet/dist/leaflet.css", "src/styles.css"], "assets": [{"glob": "**/*", "input": "public"}]}},
    "serve": {"builder": "@angular/build:dev-server", "options": {"buildTarget": "rawaa-frontend:build", "proxyConfig": "proxy.conf.json"}}
  }}}
}
